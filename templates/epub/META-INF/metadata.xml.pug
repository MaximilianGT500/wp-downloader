doctype xml
entry(xmlns:thr="http://purl.org/syndication/thread/1.0" xmlns:dcterms="http://purl.org/dc/terms/" xmlns="http://www.w3.org/2005/Atom" xmlns:schema="http://schema.org/")
    title= title
    id= "urn:uuid:" + uuid
    updated= modified
    author
        name= user.name
        uri= "https://www.wattpad.com/user/" + user.username

    published= published
    dcterms:language= langCode

    each tag in tags
        category(label=tag)

    summary= description
    link(type="image/jpeg" rel="http://opds-spec.org/image" href=cover)
    link(type="image/jpeg" rel="http://opds-spec.org/image/thumbnail" href=cover)
    content(type="html")= description
