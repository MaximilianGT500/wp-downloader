extends _layout

block title
    = book.title

block page

    .container.book-page

        a.back-link(href="/")
            span(aria-hidden="true") ←
            | 
            span= lang.book.back

        article.book

            .book-cover-wrap
                img.book-cover(src=book.cover alt=book.title loading="lazy")

            .book-details

                h1.book-title= book.title

                p.book-author
                    if book.user.avatar
                        img.avatar(src=book.user.avatar alt="" loading="lazy")
                    span= book.user.name

                dl.book-meta
                    if pubYear
                        .meta-item
                            dt= lang.book.pubDate
                            dd= pubYear
                    .meta-item
                        dt= lang.book.parts
                        dd= book.parts.length
                    if book.language && book.language.name
                        .meta-item
                            dt= lang.book.language
                            dd= book.language.name

                if book.tags && book.tags.length
                    ul.tags
                        each tag in book.tags
                            li.tag= tag

                if book.description
                    .book-description
                        h2.visually-hidden= lang.book.description
                        p#book-description-text.book-description-text= book.description
                        button#description-toggle.button-link(type="button" hidden)= lang.book.showMore

                .downloads
                    h2.visually-hidden= lang.book.downloadTitle
                    .download-card
                        .download-info
                            h3 EPUB
                            p= lang.book.download.epubHint
                        button.download-button.button.button-primary(data-book-id=book.id data-book-format="epub")= lang.book.download.epub
                    .download-card
                        .download-info
                            h3 HTML
                            p= lang.book.download.htmlHint
                        button.download-button.button.button-secondary(data-book-id=book.id data-book-format="html")= lang.book.download.html

    div#loading-modal.modal(role="dialog" aria-modal="true" aria-labelledby="loading-title" hidden)
        .modal-card
            .spinner(aria-hidden="true")
            h2#loading-title.modal-title= lang.book.loading.title
            p.modal-text= lang.book.loading.text
            p#loading-error.modal-error(role="alert" hidden)= lang.book.error
