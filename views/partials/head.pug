meta(charset="utf-8")

title
    block title
        = lang.title

meta(name="viewport" content="width=device-width, initial-scale=1")
meta(name="description" content=lang.description)
meta(name="keywords" content=lang.keywords)
meta(name="author" content="MaximilianGT500")
meta(name="color-scheme" content="light dark")
meta(name="theme-color" media="(prefers-color-scheme: light)" content="#ff6b30")
meta(name="theme-color" media="(prefers-color-scheme: dark)" content="#1b1c20")

meta(property="og:type" content="website")
meta(property="og:site_name" content=lang.title)
meta(property="og:title" content=lang.title)
meta(property="og:description" content=lang.description)
meta(property="og:url" content=lang.url)
meta(property="og:image" content=lang.image)

meta(name="twitter:card" content="summary")
meta(name="twitter:title" content=lang.title)
meta(name="twitter:description" content=lang.description)
meta(name="twitter:image" content=lang.image)

link(rel="icon" type="image/svg+xml" href="/icons/base-icon.svg")
link(rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png")
link(rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png")
link(rel="shortcut icon" href="/icons/favicon.ico")
link(rel="apple-touch-icon" href="/icons/apple-touch-icon.png")
link(rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#ff6b30")
link(rel="manifest" href="/site.webmanifest")

link(rel="stylesheet" href="/style.css")

script.
    (function () {
        try {
            var params = new URLSearchParams(window.location.search);
            var paramTheme = params.get("theme");
            var saved = localStorage.getItem("theme");
            var theme = paramTheme === "light" || paramTheme === "dark"
                ? paramTheme
                : (saved === "light" || saved === "dark"
                    ? saved
                    : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));
            document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
            document.documentElement.setAttribute("data-theme", "light");
        }
    })();
